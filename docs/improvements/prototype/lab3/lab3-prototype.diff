+static int mx_w_fwd(void) { return mx_w; }
+
+/* Paths by matching pursuit on the pilot rows seen through a window that
+ * starts at `win`: the lag that explains most of the rows' energy, removed,
+ * then the next, up to three.  A lag is a path only if it explains more than
+ * mx_auto_k times what a noise lag would (the residual energy over nc) and
+ * at least mx_auto_thr of the strongest.  pk = lag + 64 (0..127). */
+static int mx_detect(struct OFDM *ofdm, float woff_est, int win, int *pk,
+                     float *pw, float *ratio) {
+  int first = (ofdm->sync_state == trial && ofdm->sync_counter == 0);
+  int last = (ofdm->sync_state == synced && ofdm->modem_frame == ofdm->np - 1);
+  int nc = ofdm->nc, m = ofdm->m, n = 0;
+  complex float H[4][nc];
+  for (int pr = 0; pr < 4; pr++) {
+    if (first && pr == 0) continue;
+    if (last && pr == 3) continue;
+    int st = ofdm->rxbufst + ofdm->samplespersymbol +
+             pr * ofdm->samplesperframe + 1 + win;
+    if (st < 0 || st + m > ofdm->nrxbuf) continue;
+    complex float work[m];
+    complex float row[nc + 2];
+    for (int k = 0; k < m; k++)
+      work[k] = ofdm->rxbuf[st + k] * cmplxconj(woff_est * (st + k));
+    dft(ofdm, row, work);
+    for (int i = 1; i <= nc; i++) H[n][i - 1] = row[i] * conjf(ofdm->pilots[i]);
+    n++;
+  }
+  *ratio = 0.0f;
+  if (n == 0) return 0;
+  float e0 = 0.0f;
+  for (int r = 0; r < n; r++)
+    for (int i = 0; i < nc; i++) e0 += cnormf(H[r][i]);
+  float eres = e0;
+  int np = 0;
+  for (int it = 0; it < 3; it++) {
+    float bestv = 0.0f;
+    int bestd = 0;
+    for (int d = -64; d < 64; d++) {
+      float v = 0.0f;
+      for (int r = 0; r < n; r++) {
+        complex float c = 0.0f;
+        for (int i = 0; i < nc; i++)
+          c += H[r][i] * cmplxconj(TAU * (i + 1) * d / (float)m);
+        v += cnormf(c);
+      }
+      if (v > bestv) { bestv = v; bestd = d; }
+    }
+    float expl = bestv / nc;
+    if (expl < mx_auto_k * eres / nc) break;
+    if (np > 0 && expl < mx_auto_thr * pw[0]) break;
+    int dup = 0;
+    for (int j = 0; j < np; j++) {
+      int dd = abs(bestd + 64 - pk[j]);
+      if (dd > 64) dd = 128 - dd;
+      if (dd < 4) dup = 1;
+    }
+    if (dup) break;
+    pk[np] = bestd + 64;
+    pw[np] = expl;
+    np++;
+    for (int r = 0; r < n; r++) {
+      complex float a = 0.0f;
+      for (int i = 0; i < nc; i++)
+        a += H[r][i] * cmplxconj(TAU * (i + 1) * bestd / (float)m);
+      a /= nc;
+      for (int i = 0; i < nc; i++)
+        H[r][i] -= a * cmplx(TAU * (i + 1) * bestd / (float)m);
+    }
+    eres = 0.0f;
+    for (int r = 0; r < n; r++)
+      for (int i = 0; i < nc; i++) eres += cnormf(H[r][i]);
+  }
+  *ratio = e0 / (eres + 1E-20f);
+  return np;
+}
+
+static void mx_place(struct OFDM *ofdm, float woff_est, int d_sp) {
+  (void)d_sp;
+  int first = (ofdm->sync_state == trial && ofdm->sync_counter == 0);
+  int ncp = ofdm->ncp;
+  if (first) {
+    mx_w = ofdm->sample_point;
+    mx_ntrk = 0;
+    mx_hold = 0;
+  }
+  int pk[8];
+  float pw[8], ratio = 0.0f;
+  int np = mx_detect(ofdm, woff_est, mx_w, pk, pw, &ratio);
+  for (int t = 0; t < mx_ntrk; t++) mx_trka[t]++;
+  if (np == 0) {
+    mx_hold++;
+    if (mx_auto_dbg)
+      fprintf(stderr, "mxplace frame %d none ratio %.1f w %d te %d sp %d foff %.2f\n",
+              ofdm->modem_frame, (double)ratio, mx_w, ofdm->timing_est,
+              ofdm->sample_point, (double)ofdm->foff_est_hz);
+    return;
+  }
+  mx_hold = 0;
+  int lag[8];
+  int assigned[8];
+  int nas = 0;
+  float cs = 0.0f, ws = 0.0f;
+  for (int j = 0; j < np; j++) {
+    assigned[j] = 0;
+    int base = pk[j] - 64;
+    float bestdist = 1E9f;
+    int bestl = base;
+    for (int t = 0; t < mx_ntrk; t++) {
+      for (int k = -1; k <= 1; k++) {
+        float dd = fabsf((float)(base + 128 * k) - mx_trk[t]);
+        if (dd < bestdist) { bestdist = dd; bestl = base + 128 * k; }
+      }
+    }
+    if (mx_ntrk > 0 && bestdist <= 10.0f) {
+      lag[j] = bestl;
+      assigned[j] = 1;
+      nas++;
+      cs += pw[j] * lag[j];
+      ws += pw[j];
+    }
+  }
+  if (nas == 0 && mx_ntrk > 0) {
+    /* none of the known paths is visible: place the new ones around them */
+    for (int t = 0; t < mx_ntrk; t++) {
+      float a = mx_trkw[t] * powf(0.85f, (float)mx_trka[t]);
+      cs += a * mx_trk[t];
+      ws += a;
+    }
+  }
+  if (nas == 0 && mx_ntrk == 0) {
+    /* nothing known: the arrangement with the smallest spread, its centroid
+     * nearest the middle of the prefix */
+    int ord[8];
+    for (int j = 0; j < np; j++) ord[j] = j;
+    for (int i = 1; i < np; i++)
+      for (int j = i; j > 0 && pk[ord[j]] < pk[ord[j - 1]]; j--) {
+        int t = ord[j]; ord[j] = ord[j - 1]; ord[j - 1] = t;
+      }
+    int g0 = 0, gbest = -1;
+    for (int j = 0; j < np; j++) {
+      int nx = pk[ord[(j + 1) % np]] + (j + 1 == np ? 128 : 0);
+      int gap = nx - pk[ord[j]];
+      if (np == 1) gap = 128;
+      if (gap > gbest) { gbest = gap; g0 = (j + 1) % np; }
+    }
+    cs = 0.0f; ws = 0.0f;
+    for (int j = 0; j < np; j++) {
+      int q = ord[j];
+      lag[q] = pk[q] + (j < g0 ? 128 : 0) - 64;
+      cs += pw[q] * lag[q];
+      ws += pw[q];
+    }
+    float cen = cs / (ws + 1E-20f), target = -(float)ncp / 2.0f;
+    int sh = 0;
+    float bd = fabsf(cen - target);
+    for (int k = -2; k <= 2; k++)
+      if (fabsf(cen + 128.0f * k - target) < bd) { bd = fabsf(cen + 128.0f * k - target); sh = 128 * k; }
+    for (int j = 0; j < np; j++) lag[j] += sh;
+  } else {
+    float cen = cs / (ws + 1E-20f);
+    for (int j = 0; j < np; j++) {
+      if (assigned[j]) continue;
+      int base = pk[j] - 64, bestl = base;
+      float bd = 1E9f;
+      for (int k = -1; k <= 1; k++)
+        if (fabsf(base + 128.0f * k - cen) < bd) { bd = fabsf(base + 128.0f * k - cen); bestl = base + 128 * k; }
+      lag[j] = bestl;
+    }
+  }
+  /* refresh the tracks: seen paths replace their track or start one */
+  for (int j = 0; j < np; j++) {
+    int hit = -1;
+    for (int t = 0; t < mx_ntrk; t++)
+      if (fabsf(mx_trk[t] - lag[j]) <= 10.0f) hit = t;
+    if (hit < 0 && mx_ntrk < 8) {
+      hit = mx_ntrk++;
+      mx_trkw[hit] = pw[j];
+    }
+    if (hit >= 0) {
+      mx_trk[hit] = (float)lag[j];
+      mx_trkw[hit] = 0.5f * mx_trkw[hit] + 0.5f * pw[j];
+      mx_trka[hit] = 0;
+    }
+  }
+  int nt = 0;
+  for (int t = 0; t < mx_ntrk; t++) {
+    if (mx_trka[t] > 25) continue;
+    mx_trk[nt] = mx_trk[t]; mx_trkw[nt] = mx_trkw[t]; mx_trka[nt] = mx_trka[t];
+    nt++;
+  }
+  mx_ntrk = nt;
+  /* the shift that leaves the least of another symbol inside the window;
+   * a path not seen now still counts, fading with its age */
+  float wsum = 0.0f;
+  for (int t = 0; t < mx_ntrk; t++) wsum += mx_trkw[t] * powf(0.85f, (float)mx_trka[t]);
+  float c0 = 0.0f;
+  for (int t = 0; t < mx_ntrk; t++)
+    c0 += mx_trkw[t] * powf(0.85f, (float)mx_trka[t]) * mx_isi((int)lrintf(mx_trk[t]), ncp);
+  c0 /= (wsum + 1E-20f);
+  float bestc = c0;
+  int bestd = 0;
+  for (int dl = -64; dl <= 64; dl++) {
+    float c = 0.0f;
+    for (int t = 0; t < mx_ntrk; t++)
+      c += mx_trkw[t] * powf(0.85f, (float)mx_trka[t]) * mx_isi((int)lrintf(mx_trk[t]) + dl, ncp);
+    c /= (wsum + 1E-20f);
+    if (c < bestc - 1E-4f) { bestc = c; bestd = dl; }
+  }
+  if (mx_auto_dbg) {
+    fprintf(stderr, "mxplace frame %d np %d trk", ofdm->modem_frame, np);
+    for (int t = 0; t < mx_ntrk; t++)
+      fprintf(stderr, " %d(%.2f,a%d)", (int)lrintf(mx_trk[t]), (double)(mx_trkw[t] / (wsum + 1E-20f)), mx_trka[t]);
+    fprintf(stderr, " delta %d cost %.2f -> %.2f ratio %.1f w %d te %d sp %d foff %.2f\n",
+            bestd, (double)c0, (double)bestc, (double)ratio, mx_w + bestd,
+            ofdm->timing_est, ofdm->sample_point, (double)ofdm->foff_est_hz);
+  }
+  if (bestd != 0) {
+    mx_w += bestd;
+    for (int t = 0; t < mx_ntrk; t++) mx_trk[t] += bestd;
+  }
+}
