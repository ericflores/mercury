+static void ofdm_chanest_row(struct OFDM *ofdm, float t, float *aphase,
+                             float *aamp) {
+  int nc = ofdm->nc;
+  complex float g[nc + 2];
+  int first = (ofdm->sync_state == trial && ofdm->sync_counter == 0);
+  int last = (ofdm->sync_state == synced && ofdm->modem_frame == ofdm->np - 1);
+  float wp, wt, wn, wf;
+  if (mx_interp == 1) {
+    wp = 0.0f; wt = 1.0f - t; wn = t; wf = 0.0f;
+  } else if (mx_interp == 2) {
+    float t2 = t * t, t3 = t2 * t;
+    wp = 0.5f * (2 * t2 - t3 - t);
+    wt = 0.5f * (3 * t3 - 5 * t2 + 2);
+    wn = 0.5f * (4 * t2 - 3 * t3 + t);
+    wf = 0.5f * (t3 - t2);
+    if (first) { wt += wp; wp = 0.0f; }
+    if (last) { wn += wf; wf = 0.0f; }
+  } else {
+    wp = 1.0f - t; wt = 2.0f - t; wn = 1.0f + t; wf = t;
+    if (first) wp = 0.0f;
+    if (last) wf = 0.0f;
+  }
+  float ws = wp + wt + wn + wf;
+  for (int i = 1; i <= nc; i++) {
+    complex float pc = conjf(ofdm->pilots[i]);
+    g[i] = (wp * ofdm->rx_sym[0][i] + wt * ofdm->rx_sym[1][i] +
+            wn * ofdm->rx_sym[ofdm->ns + 1][i] +
+            wf * ofdm->rx_sym[ofdm->ns + 2][i]) *
+           pc / ws;
+  }
+  int half = ofdm->chanest_alt == OFDM_CHANEST_T4F3   ? 1
+             : ofdm->chanest_alt == OFDM_CHANEST_T4F5 ? 2
+                                                      : 0;
+  /* the slope across carriers was updated once this frame by ofdm_chanest_alt */
+  float th = half ? cargf(ofdm->chanest_slope + 1E-12f) : 0.0f;
+  static const float w3[3] = {1, 2, 1}, w5[5] = {1, 2, 3, 2, 1};
+  const float *wv = half == 1 ? w3 : w5;
+  for (int i = 1; i <= nc; i++) {
+    complex float h = g[i];
+    if (half) {
+      float w = 0.0f;
+      h = 0.0f;
+      for (int d = -half; d <= half; d++) {
+        int q = i + d;
+        if (q < 1 || q > nc) continue;
+        h += wv[d + half] * g[q] * cmplxconj(th * d);
+        w += wv[d + half];
+      }
+      h /= w;
+    }
+    aphase[i] = cargf(h);
+    aamp[i] = cabsf(h);
+  }
+}
