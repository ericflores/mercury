+/* isi(L): samples of another symbol inside the window when the window starts
+ * L samples after a path's useful part begins (L in [-ncp, 0] is clean) */
+static float mx_isi(int L, int ncp) {
+  int a = L > -2 ? L + 2 : 0;
+  int b = L < -ncp + 2 ? (-ncp + 2 - L) : 0;
+  return (float)(a + b);
+}
