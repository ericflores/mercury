+
+  /* ---- EXPERIMENT (scratch only): alternative channel estimators and a
+   * per-carrier noise profile from pilot residuals ---- */
+  if (mx_chanest || mx_noisew) {
+    int nc = ofdm->nc;
+    complex float hp[nc + 2], ht[nc + 2], hn[nc + 2], hf[nc + 2], g[nc + 2];
+    for (i = 0; i < nc + 2; i++) {
+      complex float pc = conjf(ofdm->pilots[i]);
+      hp[i] = ofdm->rx_sym[0][i] * pc;
+      ht[i] = ofdm->rx_sym[1][i] * pc;
+      hn[i] = ofdm->rx_sym[ofdm->ns + 1][i] * pc;
+      hf[i] = ofdm->rx_sym[ofdm->ns + 2][i] * pc;
+    }
+    int first = (ofdm->sync_state == trial && ofdm->sync_counter == 0);
+    int last = (ofdm->sync_state == synced && ofdm->modem_frame == ofdm->np - 1);
+    if (first) {
+      for (i = 0; i < 64; i++) mx_nv[i] = 0.0f;
+      mx_nv_n = 0;
+    }
+    if (!first) {
+      for (i = 1; i <= nc; i++) {
+        complex float d = ht[i] - 0.5f * (hp[i] + hn[i]);
+        mx_nv[i] += cnormf(d) / 1.5f;
+      }
+      mx_nv_n++;
+    }
+    if (mx_chanest) {
+      float wp = 0, wt = 1, wn = 1, wf = 0;
+      int fsm = 0, slope = 0;
+      switch (mx_chanest) {
+        case 1: fsm = 1; break;                           /* T2 F3, no slope comp */
+        case 2: wp = wf = 1; break;                       /* T4 F1 */
+        case 3: wp = wf = 1; fsm = 1; break;              /* T4 F3, no slope comp */
+        case 5: wp = wf = 1; wt = wn = 3; break;          /* T4 tri, F1 */
+        case 6: fsm = 1; slope = 1; break;                /* T2 F3 + slope */
+        case 7: wp = wf = 1; wt = wn = 3; fsm = 1; slope = 1; break; /* T4tri F3 + slope */
+        case 8: fsm = 2; slope = 1; break;                /* T2 F5 + slope */
+        case 9: wp = wf = 1; wt = wn = 3; fsm = 2; slope = 1; break; /* T4tri F5 + slope */
+      }
+      if (first) wp = 0;
+      if (last) wf = 0;
+      for (i = 1; i <= nc; i++)
+        g[i] = (wp * hp[i] + wt * ht[i] + wn * hn[i] + wf * hf[i]) /
+               (wp + wt + wn + wf);
+      /* common linear phase slope across carriers (sample point inside the
+       * cyclic prefix), tracked over the burst */
+      if (first) mx_slope_acc = 0.0f;
+      complex float sl = 0.0f;
+      for (i = 1; i < nc; i++) sl += g[i + 1] * conjf(g[i]);
+      mx_slope_acc = 0.7f * mx_slope_acc + sl;
+      float th = slope ? cargf(mx_slope_acc) : 0.0f;
+      static const float w3[3] = {1, 2, 1}, w5[5] = {1, 2, 3, 2, 1};
+      for (i = 1; i <= nc; i++) {
+        complex float h = g[i];
+        if (fsm) {
+          int half = fsm;
+          const float *wv = fsm == 1 ? w3 : w5;
+          float w = 0.0f;
+          h = 0.0f;
+          for (int d = -half; d <= half; d++) {
+            int q = i + d;
+            if (q < 1 || q > nc) continue;
+            h += wv[d + half] * g[q] * cmplxconj(th * d);
+            w += wv[d + half];
+          }
+          h /= w;
+        }
+        aphase_est_pilot[i] = cargf(h);
+        aamp_est_pilot[i] = cabsf(h);
+      }
+    }
+  }
