+static int mx_w;          /* the placed window, same coordinates as sample_point */
+static int mx_hold;
+static int mx_ntrk;
+static float mx_trk[8];   /* tracked path lags, relative to the placed window */
+static float mx_trkw[8];
+static int mx_trka[8];
