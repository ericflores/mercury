+/* ---- LAB (scratch): cyclic-prefix recycling.  A sample in the cyclic prefix
+ * and the sample m later carry the same signal and independent noise, so
+ * averaging the pair halves the noise on it.  mode 1: only the tail side (the
+ * window's first samples and their copies m later, never touched by the
+ * previous symbol); 2: both sides, 4 samples of guard at the head of the
+ * prefix; 3: both sides, 20 samples (2.5 ms) of guard. */
+int mx_cprec = 0;
+static void mx_cp_recycle(struct OFDM *ofdm, complex float *work, int st, float woff_est) {
+  if (!mx_cprec) return;
+  int m = ofdm->m, ncp = ofdm->ncp;
+  int delta = ofdm->sample_point - ofdm->timing_est;
+  if (delta < 0) delta = 0;
+  if (delta > ncp) delta = ncp;
+  int a = ncp - delta - 2;                       /* tail side */
+  int guard = mx_cprec == 3 ? 20 : 4;
+  int b = mx_cprec >= 2 ? delta - guard : 0;     /* head side */
+  for (int k = 0; k < a; k++) {
+    int j = st + k + m;
+    if (j < 0 || j >= ofdm->nrxbuf) break;
+    work[k] = 0.5f * (work[k] + ofdm->rxbuf[j] * cmplxconj(woff_est * j));
+  }
+  for (int k = m - b; k < m; k++) {
+    if (k < 0) continue;
+    int j = st + k - m;
+    if (j < 0 || j >= ofdm->nrxbuf) continue;
+    work[k] = 0.5f * (work[k] + ofdm->rxbuf[j] * cmplxconj(woff_est * j));
+  }
+}
